# LiteLLM Proxy — Environment Variables
# ========================================
# Copy this file to .env and fill in your actual API keys.
# The .env file is in .gitignore and will never be committed to Git.
#
# You only need to fill in the keys for providers you actually use.
# Leave unused keys empty or remove them.

# ---------------------------------------------------------------------------
# Proxy security
# ---------------------------------------------------------------------------

# Master key: the password your apps use to talk to this proxy.
# Generate a random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
LITELLM_MASTER_KEY=sk-your-master-key-here

# ---------------------------------------------------------------------------
# Database (optioneel — alleen nodig voor virtual keys / budget tracking)
# ---------------------------------------------------------------------------

# Alleen invullen als je database-features wilt. Weglaten = geen database.
# PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/litellm
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------

# "local"  → in-memory cache, works everywhere, lost on restart (default for work)
# "redis"  → persistent cache, requires Redis running and REDIS_URL set (home setup)
LITELLM_CACHE_TYPE=local

# Redis connection string — only needed when LITELLM_CACHE_TYPE=redis
# With Podman in WSL: redis://localhost:6379
REDIS_URL=

# ---------------------------------------------------------------------------
# AI Provider API Keys
# ---------------------------------------------------------------------------

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT, o-series) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek (v4-pro, v4-flash) — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenRouter (experimental models only) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
